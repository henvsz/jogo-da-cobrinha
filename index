<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
  <title>Jogo da Cobrinha</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <main class="game">
    <header class="bar">
      <h1>Cobrinha</h1>
      <div class="scores">
        <span>Pontos <strong id="score">0</strong></span>
        <span>Recorde <strong id="best">0</strong></span>
      </div>
    </header>

    <div class="board">
      <canvas id="canvas" width="400" height="400" aria-label="Tabuleiro do jogo"></canvas>
      <div class="overlay" id="overlay">
        <p class="title" id="overlayTitle">Pronto para jogar?</p>
        <p class="hint" id="overlayHint">Use as setas, WASD ou deslize o dedo.</p>
        <button id="startBtn" type="button">Jogar</button>
      </div>
    </div>

    <div class="pad" aria-label="Controles">
      <button type="button" data-dir="up" aria-label="Cima">▲</button>
      <button type="button" data-dir="left" aria-label="Esquerda">◀</button>
      <button type="button" data-dir="down" aria-label="Baixo">▼</button>
      <button type="button" data-dir="right" aria-label="Direita">▶</button>
    </div>

    <p class="foot">Espaço pausa o jogo.</p>
  </main>
  <script src="script.js"></script>
</body>
</html>
